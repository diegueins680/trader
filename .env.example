# Backend (optional; only needed for live/test trading endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# DEX trading (1inch aggregator; required for Uniswap/Curve/Sushi/Balancer/Pancake/1inch execution)
TRADER_DEX_CHAIN_ID=
TRADER_DEX_RPC_URL=
TRADER_DEX_PRIVATE_KEY=
TRADER_DEX_ADDRESS=
TRADER_DEX_1INCH_API_KEY=
TRADER_DEX_1INCH_BASE_URL=
TRADER_DEX_PROTOCOLS=
TRADER_DEX_AUTO_APPROVE=true
TRADER_DEX_APPROVE_WAIT_SEC=30

# REST API auth token (recommended for any deployment)
# Generate with: openssl rand -hex 32
TRADER_API_TOKEN=
# Optional: launch local helper APIs with --binance-live. This enables real exchange orders when trading/autostart is armed.
TRADER_BINANCE_LIVE=false
# Optional: enforce tenant-scoped ops/performance endpoints for multi-user deployments.
TRADER_MULTI_USER=false
# Optional: set to the CloudFront origin to allow CORS from the UI (e.g., https://d123.cloudfront.net).
TRADER_CORS_ORIGIN=

# Required in production: shared state directory to persist combos/journal/bot state/async jobs/LSTM weights across deploys.
# Per-feature TRADER_*_DIR vars override this; set any of them empty to disable that feature.
TRADER_STATE_DIR=

# Shared S3 bus for cross-instance combo sync (fly + Hetzner + local).
# Uses Tigris (S3-compatible object storage) provisioned via `fly storage create`.
# For plain AWS S3 instead, leave TRADER_STATE_S3_ENDPOINT empty and set a real region.
# IMPORTANT: TRADER_STATE_S3_PREFIX must be IDENTICAL on every instance for them
# to share one combos leaderboard (key: <prefix>/optimizer/top-combos.json).
# Full setup + verification: deploy/COMBOS_SYNC.md.
TRADER_STATE_S3_ENDPOINT=https://fly.storage.tigris.dev
TRADER_STATE_S3_REGION=auto
TRADER_STATE_S3_BUCKET=
TRADER_STATE_S3_PREFIX=trader-prod
# Tigris credentials (copy from `fly storage create` output / `fly secrets list`):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: push top-combos updates to another API via /state/sync (e.g., a central Fly instance).
TRADER_STATE_SYNC_URL=
# Optional: outbound state sync HTTP timeout in seconds (default: 15, max: 300).
TRADER_STATE_SYNC_TIMEOUT_SEC=
# Optional: tenant key for state sync (falls back to BINANCE/COINBASE keys when unset).
TRADER_STATE_SYNC_TENANT_KEY=
# Optional: auth token for state sync target (Authorization: Bearer <token>).
TRADER_STATE_SYNC_API_TOKEN=
# Optional: API key for state sync target (X-API-Key).
TRADER_STATE_SYNC_API_KEY=

# Required: Postgres connection for ops + combos persistence (powers GET /ops, combo metrics, strategy params).
# Example: postgresql://user:pass@host:5432/trader?sslmode=require
TRADER_DB_URL=

# Optional: exact ops kinds to skip when persisting high-volume audit rows.
TRADER_OPS_DISABLED_KINDS=
# Optional: persist Binance REST request audit rows in /ops (high-volume; disabled by default).
TRADER_BINANCE_REQUEST_OPS_ENABLED=false
# Optional: minimum interval for persisted bot.status ops snapshots (milliseconds; default 300000).
TRADER_BOT_STATUS_LOG_INTERVAL_MS=300000

# Optional: persist live bot status snapshots across restarts.
TRADER_BOT_STATE_DIR=
# Optional: default live bot symbols (comma-separated) when botSymbols is not provided.
TRADER_BOT_SYMBOLS=
# Optional: symbols that live bot auto-start and /bot/start should skip (defaults to MATICUSDT).
TRADER_BOT_DISABLED_SYMBOLS=
# Optional: live bot top-combo poll interval in seconds (default: 30).
TRADER_BOT_COMBOS_POLL_SEC=30
# Optional: steady-state top-combo bot target count for auto-start (default: 3).
TRADER_BOT_TOP_COMBO_BOTS=3
# Optional: startup-phase top-combo bot target count before the first poll cycle completes (default: 0).
TRADER_BOT_TOP_COMBO_BOTS_STARTUP=0
# Optional: maximum total symbols the server auto-start loop may manage at once (default: 3).
TRADER_BOT_AUTOSTART_MAX_BOTS=3
# Optional: maximum new bot workers the server auto-start loop may launch per poll cycle (default: 1).
TRADER_BOT_AUTOSTART_MAX_STARTS_PER_CYCLE=1
# Optional: maximum symbols a single /bot/start request may launch/adopt immediately; extra symbols are queued one-by-one after stability checks (default: 3).
TRADER_BOT_START_MAX_SYMBOLS=3
# Optional: maximum seconds a queued /bot/start waits for existing bots to become stable before failing the remaining queue; 0 waits forever (default: 1800).
TRADER_BOT_START_QUEUE_MAX_WAIT_SEC=1800

# Optional: enable the server-side background optimizer (default: true).
TRADER_OPTIMIZER_ENABLED=true
# Optional: server-side background optimizer cadence/budget (defaults: every=300, trials=20, timeout=45).
TRADER_OPTIMIZER_EVERY_SEC=900
TRADER_OPTIMIZER_TRIALS=60
TRADER_OPTIMIZER_TIMEOUT_SEC=90
# Optional: server-side background optimizer history window and exchange fetch cap (defaults: 7d, 1000).
TRADER_OPTIMIZER_LOOKBACK_WINDOW=30d
TRADER_OPTIMIZER_MAX_POINTS=2000
# Optional: LSTM sampling caps for background optimizer trials, applied to both the
# primary and discovery-recovery passes (defaults: epochs=2, hidden=16). Raise these
# on research nodes so discovery can reach larger models; heavier trials need a
# higher TRADER_OPTIMIZER_TIMEOUT_SEC and fewer TRADER_OPTIMIZER_TRIALS.
TRADER_OPTIMIZER_EPOCHS_MAX=2
TRADER_OPTIMIZER_HIDDEN_SIZE_MAX=16
# Optional: server-side background optimizer eligibility gates (defaults favor discovery over the optimize-equity CLI defaults).
TRADER_OPTIMIZER_MIN_ROUND_TRIPS=3
TRADER_OPTIMIZER_MIN_EXPOSURE=0.02
TRADER_OPTIMIZER_MIN_SHARPE=0.2
TRADER_OPTIMIZER_MIN_CALMAR=0.2
TRADER_OPTIMIZER_MIN_WF_SHARPE_MEAN=0
TRADER_OPTIMIZER_MAX_WF_SHARPE_STD=0
# Optional: if a server-side optimizer run emits only inactive/timeout rows, retry once with a narrower discovery search (default: true).
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_ENABLED=true
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TRIALS=30
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TIMEOUT_SEC=120
TRADER_OPTIMIZER_DISCOVERY_MIN_ROUND_TRIPS=1
TRADER_OPTIMIZER_DISCOVERY_MIN_EXPOSURE=0.005
TRADER_OPTIMIZER_DISCOVERY_MIN_SHARPE=0.1
TRADER_OPTIMIZER_DISCOVERY_MIN_CALMAR=0.1

# Optional: persist optimizer top-combos.json across restarts/deploys.
TRADER_OPTIMIZER_COMBOS_DIR=
# Optional: cap optimizer top-combos.json length (default: 200).
TRADER_OPTIMIZER_MAX_COMBOS=
# Optional: minimum number of top combos to persist (fallback to DB/S3 when below).
TRADER_TOP_COMBOS_MIN_PERSIST=100
# Optional: archive top-combos.json snapshots (default: <combos dir>/top-combos-history; set to off/false/0 to disable).
TRADER_OPTIMIZER_COMBOS_HISTORY_DIR=
# Optional: enable the background anti-entropy top-combos sync worker (default: true).
TRADER_TOP_COMBOS_SYNC_ENABLED=true
# Optional: top-combos anti-entropy sync cadence in seconds (default: 15, minimum: 5).
# 60s is plenty for cross-instance S3 sync and avoids needless S3 chatter.
TRADER_TOP_COMBOS_SYNC_EVERY_SEC=60

# Optional: in-memory API caching (helpful for the Web UI’s repeated calls).
TRADER_API_CACHE_TTL_MS=30000
TRADER_API_CACHE_MAX_ENTRIES=64

# Optional: override Binance REST base URLs (useful if api.binance.com is unreachable).
TRADER_BINANCE_REST_URL=
TRADER_BINANCE_TESTNET_REST_URL=
TRADER_BINANCE_FUTURES_REST_URL=
TRADER_BINANCE_FUTURES_TESTNET_REST_URL=
# Optional: route Binance HTTP requests through a fixed-IP proxy (http://user:pass@host:port).
TRADER_BINANCE_PROXY_URL=
# Optional: clear any existing Binance proxy setting in deploy scripts.
TRADER_BINANCE_PROXY_CLEAR=false
# Optional: proxy connectivity checks in deploy scripts.
TRADER_BINANCE_PROXY_HEALTHCHECK=true
TRADER_BINANCE_PROXY_HEALTHCHECK_STRICT=false

# Optional: HTTP retry/backoff tuning.
TRADER_HTTP_RETRY_MAX=5
TRADER_HTTP_RETRY_BASE_MS=300
TRADER_HTTP_RETRY_MAX_MS=12000
TRADER_HTTP_RETRY_JITTER=0.25
TRADER_HTTP_RETRY_WRITES=false

# Optional: cap API request payload sizes and optimizer output in responses.
TRADER_API_MAX_BODY_BYTES=26214400
TRADER_API_MAX_OPTIMIZER_OUTPUT_BYTES=20000

# Optional: API compute limits (defaults: bars=1000, epochs=100, hidden=32).
TRADER_API_MAX_BARS_LSTM=1000
TRADER_API_MAX_EPOCHS=100
TRADER_API_MAX_HIDDEN_SIZE=50

# Optional: persist async jobs to disk (default: .tmp/async; set empty to disable).
TRADER_API_ASYNC_DIR=

# Optional: write JSONL journal events to disk.
TRADER_JOURNAL_DIR=

# Optional: label operation/journal rows with the machine that ran them.
TRADER_SERVER_ID=local
TRADER_SERVER_ROLE=local
TRADER_SERVER_PROVIDER=local

# Optional: webhook notifications (Discord-compatible).
TRADER_WEBHOOK_URL=
# Optional: comma-separated event types to send (defaults to all webhook events).
TRADER_WEBHOOK_EVENTS=bot.started,bot.start_failed,bot.stop,bot.order,bot.halt,trade.order

# Optional: persist LSTM weights between runs (set empty to disable).
TRADER_LSTM_WEIGHTS_DIR=.tmp/lstm

# AI automation (optional; local loops and autoloop helpers)
# The autoloop prefers Claude (Anthropic) when ANTHROPIC_API_KEY is set, then
# falls back to OpenAI (OPENAI_API_KEY), then the local Codex CLI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AUTOLOOP_BACKEND=auto
# AUTOLOOP_MODEL overrides the model for whichever backend is active. Leave it
# empty to use each backend's default (claude-opus-4-8 for Anthropic, gpt-5.4
# for OpenAI/Codex). Set ANTHROPIC_MODEL/OPENAI_MODEL to change a single backend.
AUTOLOOP_MODEL=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_MODEL=gpt-5.4
AUTOLOOP_MAX_ITERATIONS=2
AUTOLOOP_FOREVER_INTERVAL_SECONDS=300
AUTOLOOP_CODEX_REASONING_EFFORT=
CODEX_LOOP_MODEL=gpt-5.4
CODEX_LOOP_ALLOW_DIRTY=0
