{$TRADER_SITE_ADDRESS:http://localhost}, 127.0.0.1:80 {
  encode zstd gzip
  root * /srv/trader-web

  route {
    @stateSync path /state/sync
    handle @stateSync {
      reverse_proxy api:8080
    }

    basic_auth {
      {$TRADER_UI_BASIC_AUTH_USER:trader} {$TRADER_UI_BASIC_AUTH_HASH}
    }

    @heavy path /api/backtest /api/backtest/* /api/optimizer/run /backtest /backtest/* /optimizer/run
    respond @heavy "optimizer and backtest workloads run on the research server" 503

    handle_path /api/* {
      reverse_proxy api:8080 {
        header_up Authorization "Bearer {$TRADER_API_TOKEN}"
        header_up X-API-Key "{$TRADER_API_TOKEN}"
      }
    }

    @api path /health /admin/* /cache /cache/* /signal /signal/* /trade /trade/* /bot/* /binance/* /optimizer/* /ops /ops/* /state/* /request-progress/* /metrics
    handle @api {
      reverse_proxy api:8080 {
        header_up Authorization "Bearer {$TRADER_API_TOKEN}"
        header_up X-API-Key "{$TRADER_API_TOKEN}"
      }
    }

    handle {
      try_files {path} /index.html
      file_server
    }
  }
}
