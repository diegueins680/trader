COMPOSE_PROJECT_NAME=trader
TRADER_CADDYFILE=Caddyfile.research
TRADER_SITE_ADDRESS=http://RESEARCH_SERVER_IP

TRADER_API_TOKEN=CHANGE_ME_RESEARCH_API_TOKEN_HEX
TRADER_UI_BASIC_AUTH_USER=trader
TRADER_UI_BASIC_AUTH_PASSWORD=CHANGE_ME_BROWSER_PASSWORD
TRADER_UI_BASIC_AUTH_HASH='CHANGE_ME_CADDY_HASH'

TRADER_SERVER_ID=hetzner-research
TRADER_SERVER_ROLE=research
TRADER_SERVER_PROVIDER=hetzner

POSTGRES_DB=trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME_RESEARCH_POSTGRES_PASSWORD_HEX
TRADER_DB_URL=postgresql://trader:CHANGE_ME_RESEARCH_POSTGRES_PASSWORD_HEX@postgres:5432/trader?sslmode=disable

TRADER_MULTI_USER=true
TRADER_BINANCE_LIVE=false
TRADER_BOT_TRADE=false
TRADER_ENABLE_BOT_WATCH=false
TRADER_BOT_AUTOSTART=false
TRADER_BOT_SYMBOLS=
TRADER_BOT_TOP_COMBO_BOTS=0
TRADER_BOT_TOP_COMBO_BOTS_STARTUP=0
TRADER_BOT_AUTOSTART_MAX_BOTS=0
TRADER_BOT_AUTOSTART_MAX_STARTS_PER_CYCLE=1
TRADER_BOT_START_MAX_SYMBOLS=1
TRADER_BOT_START_QUEUE_MAX_WAIT_SEC=1800

# Research node owns optimizer discovery and syncs combos to trading.
TRADER_OPTIMIZER_ENABLED=true
TRADER_OPTIMIZER_EVERY_SEC=900
# Fewer, heavier trials: incumbent top combos sit around epochs ~8 / hidden ~29,
# unreachable under the old epochs<=2 / hidden<=16 sampling caps. These values
# are kept in sync by CI via trader.research.env.managed (the Hetzner research
# box is the bigger discovery producer, sized above Fly research).
TRADER_OPTIMIZER_TRIALS=24
TRADER_OPTIMIZER_TIMEOUT_SEC=600
TRADER_OPTIMIZER_EPOCHS_MAX=16
TRADER_OPTIMIZER_HIDDEN_SIZE_MAX=64
TRADER_OPTIMIZER_LOOKBACK_WINDOW=30d
TRADER_OPTIMIZER_LOOKBACK_WINDOWS=7d,14d,30d
TRADER_OPTIMIZER_INTERVALS=5m,15m,1h,2h,4h,6h,12h,1d
TRADER_OPTIMIZER_MAX_POINTS=5000
TRADER_OPTIMIZER_MAX_COMBOS=1000
# Spend most discovery budget near the current validated combo neighborhoods,
# including their method families, while keeping enough broad sampling to find
# fresh regimes when the leaderboard priors go stale.
TRADER_OPTIMIZER_PRIOR_SAMPLE_PROB=0.75
TRADER_OPTIMIZER_PRIOR_METHOD_SAMPLE_PROB=0.8
TRADER_OPTIMIZER_PRIOR_RANK_BIAS=2.5
TRADER_OPTIMIZER_PRIOR_TOP_FRACTION=0.5
TRADER_OPTIMIZER_PRIOR_MIN_SAMPLES=3
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TRIALS=12
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TIMEOUT_SEC=600
TRADER_TOP_COMBOS_BACKTEST_ENABLED=false
TRADER_API_MAX_ASYNC_RUNNING=1
TRADER_API_MAX_BARS_LSTM=1500
TRADER_API_MAX_EPOCHS=50
TRADER_API_MAX_HIDDEN_SIZE=32

TRADER_STATE_SYNC_URL=http://TRADING_SERVER_IP/state/sync
TRADER_STATE_SYNC_TIMEOUT_SEC=30
# Empty means derive the tenant key from BINANCE_API_KEY / BINANCE_API_SECRET.
# To match Hetzner trading, research must use the same Binance key pair.
TRADER_STATE_SYNC_TENANT_KEY=
TRADER_STATE_SYNC_API_TOKEN=CHANGE_ME_TRADING_API_TOKEN_HEX

# --- Cross-instance combo sync (shared S3 bus) ---
# fly, hetzner-research, hetzner-trading, and local share ONE combo leaderboard by
# pointing at the same bucket with an IDENTICAL prefix. See deploy/COMBOS_SYNC.md.
# (The research->trading /state/sync above is kept as Hetzner-internal redundancy.)
TRADER_STATE_S3_ENDPOINT=https://fly.storage.tigris.dev
TRADER_STATE_S3_REGION=auto
TRADER_STATE_S3_BUCKET=REPLACE_WITH_TIGRIS_BUCKET
TRADER_STATE_S3_PREFIX=trader-prod
# Tigris credentials — from `fly storage create` output (or `fly ssh console` / `fly secrets`).
AWS_ACCESS_KEY_ID=CHANGE_ME_TIGRIS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_TIGRIS_SECRET_ACCESS_KEY
TRADER_TOP_COMBOS_SYNC_ENABLED=true
TRADER_TOP_COMBOS_SYNC_EVERY_SEC=60

TRADER_BINANCE_REQUEST_OPS_ENABLED=false
TRADER_BOT_STATUS_LOG_INTERVAL_MS=300000
TRADER_API_CACHE_TTL_MS=30000
TRADER_API_CACHE_MAX_ENTRIES=64

# Use the same Binance credential pair as Hetzner trading when research should
# share trading's tenant key. Keep live/trade disabled on research unless you
# intentionally allow this host to place orders.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# LLM provider for the continuous-improvement autoloop (prefers Claude when set).
# Falls back to OPENAI_API_KEY, then the local Codex CLI. See docs/ai-workflow.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

TRADER_WEBHOOK_URL=
TRADER_WEBHOOK_EVENTS=bot.started,bot.start_failed,bot.stop,bot.order,bot.halt,trade.order
