# CI-managed non-secret defaults and optimizer tuning for the Hetzner RESEARCH box.
#
# Deployed by .github/workflows/deploy-hetzner.yml via deploy-remote.sh: every
# KEY=VALUE line here is updated-or-appended into the box's secret env file on
# each deploy, so this tuning ships from the repo instead of by hand. Do NOT
# put secrets here — this file is checked in.
#
# Leave TRADER_STATE_SYNC_TENANT_KEY empty so the API derives the tenant from
# BINANCE_API_KEY / BINANCE_API_SECRET. Hetzner research should use the same
# Binance credential pair as Hetzner trading when it needs the same tenant.
TRADER_STATE_SYNC_TENANT_KEY=

TRADER_OPTIMIZER_ENABLED=true
TRADER_OPTIMIZER_EVERY_SEC=300
# Search enough candidates to find active combos while keeping each trial small
# enough for the research box to keep turning over.
TRADER_OPTIMIZER_TRIALS=24
TRADER_OPTIMIZER_TIMEOUT_SEC=300
TRADER_OPTIMIZER_EPOCHS_MAX=6
TRADER_OPTIMIZER_HIDDEN_SIZE_MAX=32
# Keep the sampled low-threshold discovery guesses instead of sweeping upward
# into no-trade thresholds before the activity gate can evaluate them.
TRADER_OPTIMIZER_TUNE_MAX_THRESHOLD_CANDIDATES=0
TRADER_OPTIMIZER_LOOKBACK_WINDOW=30d
TRADER_OPTIMIZER_LOOKBACK_WINDOWS=30d
TRADER_OPTIMIZER_AUTO_CAPPED_LOOKBACKS=true
TRADER_OPTIMIZER_SYMBOLS=DOGEUSDT,FILUSDT,ADAUSDT,AVAXUSDT,UNIUSDT,ATOMUSDT,LTCUSDT,ETHUSDT,SOLUSDT,DOTUSDT,NEARUSDT,BCHUSDT,XRPUSDT,LINKUSDT,BTCUSDT
TRADER_OPTIMIZER_INTERVALS=1h,2h,4h,6h
TRADER_OPTIMIZER_MAX_POINTS=1500
TRADER_OPTIMIZER_MAX_COMBOS=1000
# Spend most discovery budget near currently validated combo neighborhoods while
# still leaving random exploration budget for regime changes.
TRADER_OPTIMIZER_PRIOR_SAMPLE_PROB=0.75
TRADER_OPTIMIZER_PRIOR_METHOD_SAMPLE_PROB=0.35
TRADER_OPTIMIZER_PRIOR_RANK_BIAS=2.5
TRADER_OPTIMIZER_PRIOR_EDGE_WEIGHT=0.25
TRADER_OPTIMIZER_PRIOR_TOP_FRACTION=0.75
TRADER_OPTIMIZER_PRIOR_MIN_SAMPLES=48
TRADER_OPTIMIZER_PRIOR_AGE_HALF_LIFE_DAYS=45
TRADER_OPTIMIZER_PRIOR_MISSING_AGE_MULTIPLIER=0.25
TRADER_OPTIMIZER_PRIOR_DIVERSITY_MAX_PER_BUCKET=12
TRADER_OPTIMIZER_PRIOR_SEED_COUNT=2
TRADER_OPTIMIZER_PRIOR_PERTURB_SCALE_DOUBLE=0.08
TRADER_OPTIMIZER_PRIOR_PERTURB_SCALE_INT=2
TRADER_OPTIMIZER_SURVIVOR_EDGE_WEIGHT=0.15
TRADER_OPTIMIZER_SURVIVOR_RANK_BIAS=2.0
TRADER_OPTIMIZER_MIN_ROUND_TRIPS=2
TRADER_OPTIMIZER_MIN_EXPOSURE=0.01
TRADER_OPTIMIZER_MIN_SHARPE=0
TRADER_OPTIMIZER_MIN_CALMAR=0
TRADER_OPTIMIZER_MIN_WF_SHARPE_MEAN=0
TRADER_OPTIMIZER_MAX_WF_SHARPE_STD=3
TRADER_OPTIMIZER_SEARCH_MAX_WF_SHARPE_STD=20
TRADER_OPTIMIZER_WF_SHARPE_STD_SCORE_PENALTY=0.05
TRADER_OPTIMIZER_METHOD_WEIGHT_11=0.5
TRADER_OPTIMIZER_METHOD_WEIGHT_01=7
TRADER_OPTIMIZER_METHOD_WEIGHT_10=1.5
TRADER_OPTIMIZER_METHOD_WEIGHT_EDGE_BLEND=0
TRADER_OPTIMIZER_METHOD_WEIGHT_EDGE_PICK=0
TRADER_OPTIMIZER_METHOD_WEIGHT_REGIME_SWITCH=0
TRADER_OPTIMIZER_METHOD_WEIGHT_BANDIT_ROUTER=0
TRADER_OPTIMIZER_P_LONG_SHORT=0.2
TRADER_OPTIMIZER_P_COST_AWARE_EDGE=0.25
TRADER_OPTIMIZER_KALMAN_SENSOR_CORRELATION_INFLATION=0
TRADER_OPTIMIZER_KALMAN_INNOVATION_INFLATION_THRESHOLD=0
TRADER_OPTIMIZER_KALMAN_INNOVATION_INFLATION_MAX=10
# Enrich discovery trials with same-asset Coinbase data (basis/lead-lag) for
# Coinbase-eligible symbols/intervals; fail-open to Binance-only otherwise.
TRADER_OPTIMIZER_CROSS_EXCHANGE_COINBASE=false
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_ENABLED=true
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TRIALS=48
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TIMEOUT_SEC=300
TRADER_OPTIMIZER_DISCOVERY_OPEN_THRESHOLD_MIN=0.00005
TRADER_OPTIMIZER_DISCOVERY_OPEN_THRESHOLD_MAX=0.0035
TRADER_OPTIMIZER_DISCOVERY_CLOSE_THRESHOLD_MIN=0.000001
TRADER_OPTIMIZER_DISCOVERY_CLOSE_THRESHOLD_MAX=0.004
TRADER_OPTIMIZER_DISCOVERY_MIN_ROUND_TRIPS=1
TRADER_OPTIMIZER_DISCOVERY_MIN_EXPOSURE=0.003
TRADER_OPTIMIZER_DISCOVERY_MIN_SHARPE=0
TRADER_OPTIMIZER_DISCOVERY_MIN_CALMAR=0
# Periodic leaderboard refresh: re-backtest top combos under the current cost
# model so stale pre-cost-fix scores deflate honestly and fresh discoveries
# can rank in. The board froze on 2026-03-25 because its rank-500 floor
# (annualized ~5x, scored under the old optimistic cost model) is unreachable
# for any honest candidate. Keep this lighter than discovery so refreshed
# combos re-rank without starving fresh candidate generation.
TRADER_TOP_COMBOS_BACKTEST_ENABLED=true
TRADER_TOP_COMBOS_BACKTEST_TOP_N=80
TRADER_TOP_COMBOS_BACKTEST_EVERY_SEC=10800
TRADER_TOP_COMBOS_BACKTEST_STALE_DAYS=2
TRADER_TOP_COMBOS_BACKTEST_PRUNE_FINAL_EQUITY_FLOOR=1.0
TRADER_TOP_COMBO_SCORE_FRESHNESS_HALF_LIFE_DAYS=30
TRADER_TOP_COMBO_SCORE_FRESHNESS_FLOOR_MULTIPLIER=0.10
# Allow refresh/validation of combos up to the discovery sampling cap.
TRADER_API_MAX_HIDDEN_SIZE=64
