# CI-managed non-secret defaults and optimizer tuning for the Hetzner RESEARCH box.
#
# Deployed by .github/workflows/deploy-hetzner.yml via deploy-remote.sh: every
# KEY=VALUE line here is updated-or-appended into the box's secret env file on
# each deploy, so this tuning ships from the repo instead of by hand. Do NOT
# put secrets here — this file is checked in.
#
# Leave TRADER_STATE_SYNC_TENANT_KEY empty so the API derives the tenant from
# BINANCE_API_KEY / BINANCE_API_SECRET. Hetzner research should use the same
# Binance credential pair as Hetzner trading when it needs the same tenant.
TRADER_STATE_SYNC_TENANT_KEY=
TRADER_OPS_ROLLUP_ON_DEPLOY=true
# S3/Tigris is the primary combo sync path. Keep the legacy HTTP push disabled
# on research so it does not load the trading API with long /state/sync posts.
TRADER_STATE_SYNC_URL=

# 2026-07-02 14-day BNBUSDT 1h preset winner:
# ta_regime_switch_relaxed, ROI +9.503358528250305%.
TRADER_BOT_START_METHOD=ta_regime_switch
TRADER_BOT_START_VOL_CONF_GATE=disabled
TRADER_BOT_START_COST_AWARE_EDGE=false
TRADER_BOT_START_MIN_EDGE=0
TRADER_BOT_START_MIN_SIGNAL_TO_NOISE=0
TRADER_BOT_START_OPEN_THRESHOLD=0.001
TRADER_BOT_START_CLOSE_THRESHOLD=0.001
TRADER_BOT_START_TOP_COMBO_ADOPTION=true

TRADER_OPTIMIZER_ENABLED=true
TRADER_OPTIMIZER_EVERY_SEC=180
# Search for live-adoptable candidates, not just low-trade leaderboard churn.
# These trials are heavier, but the research box is the producer and trading
# stays read-mostly.
# Keep long-horizon batches small enough to merge evidence each cycle instead
# of withholding every completed trial behind an hours-long process.
TRADER_OPTIMIZER_TRIALS=4
TRADER_OPTIMIZER_TIMEOUT_SEC=600
TRADER_OPTIMIZER_EPOCHS_MAX=8
TRADER_OPTIMIZER_HIDDEN_SIZE_MAX=48
# Leave headroom for the API, PostgreSQL, and filesystem cache on the 15 GiB
# research host. The optimizer records heap-overflow trials as failures.
TRADER_OPTIMIZER_TRIAL_HEAP_CAP=8g
# Keep the sampled low-threshold discovery guesses instead of sweeping upward
# into no-trade thresholds before the activity gate can evaluate them.
TRADER_OPTIMIZER_TUNE_MAX_THRESHOLD_CANDIDATES=0
# The portfolio selector consumes the 20% OOS curve. A 1,100-day 6h scope
# yields about 220 daily observations while staying under MAX_POINTS=5000.
TRADER_OPTIMIZER_LOOKBACK_WINDOW=1100d
TRADER_OPTIMIZER_LOOKBACK_WINDOWS=1100d
TRADER_OPTIMIZER_AUTO_CAPPED_LOOKBACKS=true
TRADER_OPTIMIZER_LOOKBACK_HEADROOM_POINTS=64
TRADER_OPTIMIZER_SYMBOLS=AAVEUSDT,ADAUSDT,ARBUSDT,ATOMUSDT,AVAXUSDT,BCHUSDT,BNBUSDT,BTCUSDT,DOGEUSDT,DOTUSDT,ETCUSDT,ETHUSDT,FILUSDT,LINKUSDT,LTCUSDT,NEARUSDT,OPUSDT,SOLUSDT,SUIUSDT,TRXUSDT,UNIUSDT,XRPUSDT
TRADER_OPTIMIZER_INTERVALS=6h
TRADER_OPTIMIZER_MAX_POINTS=5000
TRADER_OPTIMIZER_MAX_COMBOS=5000
# Spend some discovery budget near currently validated combo neighborhoods
# without letting stale, weak priors dominate fresh deployable searches.
TRADER_OPTIMIZER_PRIOR_SAMPLE_PROB=0.35
TRADER_OPTIMIZER_PRIOR_METHOD_SAMPLE_PROB=0.30
TRADER_OPTIMIZER_PRIOR_RANK_BIAS=2.5
TRADER_OPTIMIZER_PRIOR_EDGE_WEIGHT=0.25
TRADER_OPTIMIZER_PRIOR_TOP_FRACTION=0.50
TRADER_OPTIMIZER_PRIOR_MIN_SAMPLES=24
TRADER_OPTIMIZER_PRIOR_AGE_HALF_LIFE_DAYS=21
TRADER_OPTIMIZER_PRIOR_MISSING_AGE_MULTIPLIER=0.10
TRADER_OPTIMIZER_PRIOR_DIVERSITY_MAX_PER_BUCKET=8
TRADER_OPTIMIZER_PRIOR_SEED_COUNT=0
TRADER_OPTIMIZER_PRIOR_PERTURB_SCALE_DOUBLE=0.08
TRADER_OPTIMIZER_PRIOR_PERTURB_SCALE_INT=2
TRADER_OPTIMIZER_HYPERBAND=true
TRADER_OPTIMIZER_HYPERBAND_SEED_BUDGET=0.35
TRADER_OPTIMIZER_SURROGATE_GUIDANCE=true
TRADER_OPTIMIZER_SURROGATE_SAMPLE_PROB=0.25
TRADER_OPTIMIZER_ACTIVE_SUBSPACE=true
TRADER_OPTIMIZER_ACTIVE_SUBSPACE_PARAM_FRACTION=0.45
TRADER_OPTIMIZER_MAP_ELITES=true
TRADER_OPTIMIZER_MAP_ELITES_PER_BUCKET=2
TRADER_OPTIMIZER_CMA_LOCAL_SEARCH=true
TRADER_OPTIMIZER_SURVIVOR_EDGE_WEIGHT=0.15
TRADER_OPTIMIZER_SURVIVOR_RANK_BIAS=2.0
# Match the live-adoption activity floor in the primary pass. Recovery remains
# exploratory; strict merge evidence decides whether its output is deployable.
TRADER_OPTIMIZER_MIN_ROUND_TRIPS=20
TRADER_OPTIMIZER_MIN_EXPOSURE=0.02
TRADER_OPTIMIZER_MIN_SHARPE=0
TRADER_OPTIMIZER_MIN_CALMAR=0
TRADER_OPTIMIZER_MIN_WF_SHARPE_MEAN=0.3
TRADER_OPTIMIZER_MAX_WF_SHARPE_STD=1.5
TRADER_OPTIMIZER_SEARCH_MAX_WF_SHARPE_STD=3
TRADER_OPTIMIZER_WF_SHARPE_STD_SCORE_PENALTY=0.05
TRADER_OPTIMIZER_METHOD_WEIGHT_11=0
TRADER_OPTIMIZER_METHOD_WEIGHT_01=1
TRADER_OPTIMIZER_METHOD_WEIGHT_10=1
TRADER_OPTIMIZER_METHOD_WEIGHT_EDGE_BLEND=0
TRADER_OPTIMIZER_METHOD_WEIGHT_EDGE_PICK=0
TRADER_OPTIMIZER_METHOD_WEIGHT_REGIME_SWITCH=0
TRADER_OPTIMIZER_METHOD_WEIGHT_BANDIT_ROUTER=0
TRADER_OPTIMIZER_METHOD_WEIGHT_CROSS_SECTIONAL_MOMENTUM=1
TRADER_OPTIMIZER_METHOD_WEIGHT_ONLINE_NN=0
TRADER_OPTIMIZER_METHOD_WEIGHT_TA_TREND=1
TRADER_OPTIMIZER_METHOD_WEIGHT_TA_REVERSION=1
TRADER_OPTIMIZER_METHOD_WEIGHT_TA_BREAKOUT=1
TRADER_OPTIMIZER_METHOD_WEIGHT_TA_BEST=4
TRADER_OPTIMIZER_METHOD_WEIGHT_TA_REGIME_SWITCH=5
TRADER_OPTIMIZER_METHOD_WEIGHT_SMA_CROSS=0
TRADER_OPTIMIZER_METHOD_WEIGHT_SMA_CROSS_REGIME=0
TRADER_OPTIMIZER_P_LONG_SHORT=0.2
TRADER_OPTIMIZER_P_COST_AWARE_EDGE=1.0
TRADER_OPTIMIZER_KALMAN_SENSOR_CORRELATION_INFLATION=0
TRADER_OPTIMIZER_KALMAN_INNOVATION_INFLATION_THRESHOLD=0
TRADER_OPTIMIZER_KALMAN_INNOVATION_INFLATION_MAX=10
# Enrich discovery trials with same-asset Coinbase data (basis/lead-lag) for
# Coinbase-eligible symbols/intervals; fail-open to Binance-only otherwise.
TRADER_OPTIMIZER_CROSS_EXCHANGE_COINBASE=false
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_ENABLED=true
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TRIALS=6
TRADER_OPTIMIZER_DISCOVERY_RECOVERY_TIMEOUT_SEC=600
TRADER_OPTIMIZER_DISCOVERY_OPEN_THRESHOLD_MIN=0.00005
TRADER_OPTIMIZER_DISCOVERY_OPEN_THRESHOLD_MAX=0.0035
TRADER_OPTIMIZER_DISCOVERY_CLOSE_THRESHOLD_MIN=0.000001
TRADER_OPTIMIZER_DISCOVERY_CLOSE_THRESHOLD_MAX=0.004
# Production observations showed the broad 0.18%..0.60% edge band spending
# every long-horizon trial on zero-trade candidates. Stay above the venue cost
# floor while concentrating discovery where activity evidence is attainable.
TRADER_OPTIMIZER_DISCOVERY_MIN_EDGE_MIN=0.0018
TRADER_OPTIMIZER_DISCOVERY_MIN_EDGE_MAX=0.0024
TRADER_OPTIMIZER_DISCOVERY_MIN_ROUND_TRIPS=1
TRADER_OPTIMIZER_DISCOVERY_MIN_EXPOSURE=0.005
TRADER_OPTIMIZER_DISCOVERY_MIN_SHARPE=0
TRADER_OPTIMIZER_DISCOVERY_MIN_CALMAR=0
# Periodic leaderboard refresh: re-backtest top combos under the current cost
# model so stale pre-cost-fix scores deflate honestly and fresh discoveries
# can rank in. The board froze on 2026-03-25 because its rank-500 floor
# (annualized ~5x, scored under the old optimistic cost model) is unreachable
# for any honest candidate. Keep this lighter than discovery so refreshed
# combos re-rank without starving fresh candidate generation.
TRADER_TOP_COMBOS_BACKTEST_ENABLED=true
TRADER_TOP_COMBOS_BACKTEST_TOP_N=20
TRADER_TOP_COMBOS_BACKTEST_EVERY_SEC=86400
TRADER_TOP_COMBOS_BACKTEST_STALE_DAYS=7
TRADER_TOP_COMBOS_BACKTEST_PRUNE_FINAL_EQUITY_FLOOR=1.01
TRADER_TOP_COMBO_SCORE_FRESHNESS_HALF_LIFE_DAYS=30
TRADER_TOP_COMBO_SCORE_FRESHNESS_FLOOR_MULTIPLIER=0.10
TRADER_TOP_COMBO_SCORE_MAP_ELITE_MAX_PER_BUCKET=3
TRADER_TOP_COMBOS_SYNC_INITIAL_DELAY_SEC=30
TRADER_TOP_COMBOS_SYNC_MAX_COMBOS=5000
# Allow refresh/validation of combos up to the discovery sampling cap.
TRADER_API_MAX_HIDDEN_SIZE=64
