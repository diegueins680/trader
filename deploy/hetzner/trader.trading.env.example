COMPOSE_PROJECT_NAME=trader
TRADER_CADDYFILE=Caddyfile.trading
TRADER_SITE_ADDRESS=http://TRADING_SERVER_IP

TRADER_API_TOKEN=CHANGE_ME_TRADING_API_TOKEN_HEX
TRADER_UI_BASIC_AUTH_USER=trader
TRADER_UI_BASIC_AUTH_PASSWORD=CHANGE_ME_BROWSER_PASSWORD
TRADER_UI_BASIC_AUTH_HASH='CHANGE_ME_CADDY_HASH'

TRADER_SERVER_ID=hetzner-trading
TRADER_SERVER_ROLE=trading
TRADER_SERVER_PROVIDER=hetzner

POSTGRES_DB=trader
POSTGRES_USER=trader
POSTGRES_PASSWORD=CHANGE_ME_TRADING_POSTGRES_PASSWORD_HEX
TRADER_DB_URL=postgresql://trader:CHANGE_ME_TRADING_POSTGRES_PASSWORD_HEX@postgres:5432/trader?sslmode=disable

TRADER_MULTI_USER=true
TRADER_BINANCE_LIVE=false
TRADER_BOT_TRADE=false
TRADER_ENABLE_BOT_WATCH=true
TRADER_BOT_AUTOSTART=true
TRADER_BOT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
TRADER_BOT_TOP_COMBO_BOTS=3
TRADER_BOT_TOP_COMBO_BOTS_STARTUP=3
TRADER_BOT_AUTOSTART_MAX_BOTS=3
TRADER_BOT_AUTOSTART_MAX_STARTS_PER_CYCLE=1
TRADER_BOT_START_MAX_SYMBOLS=1
TRADER_BOT_START_QUEUE_MAX_WAIT_SEC=1800
TRADER_BOT_START_METHOD=
TRADER_BOT_START_VOL_CONF_GATE=
TRADER_BOT_START_COST_AWARE_EDGE=
TRADER_BOT_START_MIN_EDGE=
TRADER_BOT_START_MIN_SIGNAL_TO_NOISE=
TRADER_BOT_START_OPEN_THRESHOLD=
TRADER_BOT_START_CLOSE_THRESHOLD=
TRADER_BOT_START_ADOPTION_RELAX_GATES=true
TRADER_BOT_START_ADOPTION_RELAX_TARGET_COUNT=3
TRADER_BOT_START_TOP_COMBO_ADOPTION=true
TRADER_BOT_START_FORCE_ENV_PRESET=false
TRADER_PORTFOLIO_SELECTOR_ROLLOUT_MODE=shadow
TRADER_PORTFOLIO_SELECTOR_MAX_BOTS=3
TRADER_PORTFOLIO_SELECTOR_MAX_BOT_WEIGHT=0.25
TRADER_PORTFOLIO_SELECTOR_MAX_GROSS_WEIGHT=0.75
TRADER_PORTFOLIO_SELECTOR_MAX_DRAWDOWN=0.10
TRADER_PORTFOLIO_SELECTOR_MIN_DAYS=180
TRADER_PORTFOLIO_SELECTOR_BOOTSTRAP_SAMPLES=1000
TRADER_PORTFOLIO_SELECTOR_BLOCK_DAYS=7
TRADER_PORTFOLIO_SELECTOR_ROTATION_IMPROVEMENT=0.02
TRADER_PORTFOLIO_SELECTOR_ROTATION_PROBABILITY=0.90
TRADER_CROSS_EXCHANGE_COINBASE=true

# Trading stays responsive while trader-research owns heavy discovery and
# evidence backfills; this node only consumes the shared leaderboard.
TRADER_OPTIMIZER_ENABLED=false
TRADER_OPTIMIZER_MAX_COMBOS=5000
TRADER_TOP_COMBOS_BACKTEST_ENABLED=false
TRADER_TOP_COMBOS_BACKTEST_TOP_N=80
TRADER_TOP_COMBOS_BACKTEST_EVERY_SEC=10800
TRADER_TOP_COMBOS_BACKTEST_STALE_DAYS=2
TRADER_TOP_COMBOS_BACKTEST_PRUNE_FINAL_EQUITY_FLOOR=1.01
TRADER_API_MAX_ASYNC_RUNNING=1
TRADER_API_TRADE_TIMEOUT_SEC=600
TRADER_BINANCE_POSITIONS_TIMEOUT_SEC=45
TRADER_API_MAX_BARS_LSTM=1000
TRADER_API_MAX_EPOCHS=30
TRADER_API_MAX_HIDDEN_SIZE=32
TRADER_LSTM_REUSE_PERSISTED=false

# Empty means derive the tenant key from BINANCE_API_KEY / BINANCE_API_SECRET,
# which is also what live bot auto-start uses.
TRADER_STATE_SYNC_TENANT_KEY=

# --- Cross-instance combo sync (shared S3 bus) ---
# fly, hetzner-research, hetzner-trading, and local share ONE combo leaderboard by
# pointing at the same bucket with an IDENTICAL prefix. See deploy/COMBOS_SYNC.md.
TRADER_STATE_S3_ENDPOINT=https://fly.storage.tigris.dev
TRADER_STATE_S3_REGION=auto
TRADER_STATE_S3_BUCKET=REPLACE_WITH_TIGRIS_BUCKET
TRADER_STATE_S3_PREFIX=trader-prod
# Tigris credentials — from `fly storage create` output (or `fly ssh console` / `fly secrets`).
AWS_ACCESS_KEY_ID=CHANGE_ME_TIGRIS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_TIGRIS_SECRET_ACCESS_KEY
TRADER_TOP_COMBOS_SYNC_ENABLED=true
TRADER_TOP_COMBOS_SYNC_EVERY_SEC=60
TRADER_TOP_COMBOS_SYNC_INITIAL_DELAY_SEC=30
TRADER_TOP_COMBOS_SYNC_MAX_COMBOS=5000

TRADER_BINANCE_REQUEST_OPS_ENABLED=false
TRADER_BOT_STATUS_LOG_INTERVAL_MS=300000
TRADER_API_CACHE_TTL_MS=30000
TRADER_API_CACHE_MAX_ENTRIES=64

# Binance credentials define the trading tenant key. If Hetzner research should
# inspect/sync the same tenant, give research this same key pair too.
BINANCE_API_KEY=
BINANCE_API_SECRET=
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# LLM provider for the continuous-improvement autoloop (prefers Claude when set).
# Falls back to OPENAI_API_KEY, then the local Codex CLI. See docs/ai-workflow.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

TRADER_WEBHOOK_URL=http://webhook-bridge:8081/webhook
TRADER_WEBHOOK_EVENTS=bot.started,bot.start_failed,bot.stop,bot.order,bot.halt,trade.order

ALERT_PHONE=593984755301
CALLMEBOT_APIKEY=YOUR_CALLMEBOT_APIKEY
