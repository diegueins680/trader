# CI-managed non-secret defaults for the Hetzner TRADING box.
#
# Leave TRADER_STATE_SYNC_TENANT_KEY empty so the API derives the tenant from
# BINANCE_API_KEY / BINANCE_API_SECRET, matching live bot auto-start.
TRADER_STATE_SYNC_TENANT_KEY=
TRADER_OPS_ROLLUP_ON_DEPLOY=true

# Inform live Binance signal/trade/bot decisions with same-asset Coinbase data.
# Fetches fail open to Binance-only when Coinbase is unavailable.
TRADER_CROSS_EXCHANGE_COINBASE=true

# Hetzner is the sole live executor. Fly is deployed read-only so a release
# cannot create two order-writing runtimes. Keep the full production universe
# eligible while running the five explicitly reviewed relaxed candidates plus
# one strict-tier (no relaxed gates) pinned candidate for each of 13 further
# symbols, targeting 18 workers. On 2026-10-26 nine retired pins were replaced
# for AAVE, BCH, DOGE, DOT, ETH, FIL, NEAR, OP and SOL. AAVE and FIL
# were refreshed again after their replacement pins became raw. ARB, ATOM,
# ETH, LINK, OP and XRP still need qualifying evidence; unavailable pins
# fail closed.
# The caps were held at 8 on 2026-10-12 while leaderboard sync/build memory
# churn was addressed (#336, #337, #339). The configured ceiling is not a
# measurement of eighteen-worker memory capacity.
# Open positions retain their origin combo until flat so a strategy rotation
# cannot change exit semantics mid-trade.
TRADER_BINANCE_LIVE=true
TRADER_BOT_TRADE=true
TRADER_BOT_PROTECTION_ORDERS=true
TRADER_BOT_AUTOSTART=true
TRADER_BOT_SYMBOLS=AVAXUSDT,UNIUSDT,SUIUSDT,ETCUSDT,ADAUSDT,AAVEUSDT,ARBUSDT,ATOMUSDT,BCHUSDT,DOGEUSDT,DOTUSDT,ETHUSDT,FILUSDT,LINKUSDT,NEARUSDT,OPUSDT,SOLUSDT,XRPUSDT
TRADER_BOT_DISABLED_SYMBOLS=MATICUSDT
TRADER_BOT_TOP_COMBO_BOTS=18
TRADER_BOT_TOP_COMBO_BOTS_STARTUP=18
TRADER_BOT_AUTOSTART_MAX_BOTS=18
TRADER_BOT_AUTOSTART_MAX_STARTS_PER_CYCLE=2
# Manual/bulk POST /bot/start admits at most this many symbols immediately and
# queues the rest, so an operator or recovery burst cannot launch 18 initialisation
# workers at once; auto-start is bounded separately by the caps above.
TRADER_BOT_START_MAX_SYMBOLS=8
TRADER_BOT_START_METHOD=ta_best
TRADER_BOT_START_VOL_CONF_GATE=
TRADER_BOT_START_COST_AWARE_EDGE=
TRADER_BOT_START_MIN_EDGE=
TRADER_BOT_START_MIN_SIGNAL_TO_NOISE=
TRADER_BOT_START_OPEN_THRESHOLD=
TRADER_BOT_START_CLOSE_THRESHOLD=
# Eighteen workers at a 1% adoption cap remain bounded to 18% aggregate
# configured exposure.
TRADER_BOT_START_ADOPTION_MAX_POSITION_SIZE_CAP=0.01
TRADER_BOT_START_ADOPTION_RELAX_GATES=true
TRADER_BOT_START_ADOPTION_RELAX_TARGET_COUNT=5
TRADER_BOT_START_TOP_COMBO_ADOPTION=true
TRADER_BOT_START_ALLOW_STALE_INCOMPLETE_COMBOS=true
TRADER_BOT_START_FORCE_ENV_PRESET=false
# Keep the reviewed UUID pins stable; online combo replacement would make the
# pinning controller restart a worker to restore its requested candidate.
TRADER_BOT_ONLINE_OPTIMIZER_ENABLED=false
TRADER_TOP_COMBO_DEPLOYABLE_OVERRIDE_UUIDS=efe1c81e-2094-c945-af30-8bf25a554157,da78765a-657f-5589-af9c-d289555660cc,62c95834-cbb5-7dba-a5b9-25594e9df953,76a9c22a-45ff-94b9-067f-f3d3c7b8350f,9a50374e-f0ba-f495-bb4b-2bf3c4478921,c089b5f4-e289-7da8-5974-bf1070c3a9c7,35a1c1f6-58ad-5bd4-0ae9-5d8513372261,a9974fcf-5e6d-e068-bfac-000e85f79054,f5441231-6161-db5a-e33f-a912ac7a6654,db3ec40a-bd50-1043-3b6a-7d1484526ae9,d1de37ed-f901-d7e7-02c1-06a9b40fc349,984f89ce-991a-96b1-5ef1-acfc13cf85bd,796f12cb-8aee-1cc4-b9df-43924534aeb5,7a6d8382-1721-e94b-3687-83acd59f72b8,13a260fc-b124-beb9-2c32-d2fe8ba08a28,f7dca38c-de7b-294d-a4e0-6c78526128df,3cad5e14-c842-ea26-8c87-1e865ecf357b,4d506e36-2922-0643-615b-dc2192d68c46
# Keep the existing maker-first behavior explicit. Inspect bot.order
# executionPath before tuning these values on the three-worker canary.
TRADER_EXECUTION_MAKER_FIRST=true
TRADER_EXECUTION_MAKER_OFFSET_BPS=2
TRADER_EXECUTION_MAKER_TIMEOUT_SEC=3
TRADER_EXECUTION_MAKER_POLL_MS=250
TRADER_EXECUTION_MAKER_FALLBACK_MARKET=true
TRADER_MARKET_RISK_ENABLED=true
TRADER_MARKET_RISK_FAIL_CLOSED=true
TRADER_MARKET_RISK_MAX_AGE_SEC=30
TRADER_MARKET_RISK_MAX_ADL_AGE_SEC=3600
TRADER_MARKET_RISK_MAX_SHADOW_AGE_SEC=900
TRADER_MARKET_RISK_MAX_SPREAD_BPS=20
TRADER_MARKET_RISK_MAX_IMPACT_BPS=35
TRADER_MARKET_RISK_MAX_MARK_BASIS_BPS=100
TRADER_API_MAX_HIDDEN_SIZE=64
TRADER_LSTM_REUSE_PERSISTED=true
TRADER_PORTFOLIO_SELECTOR_ROLLOUT_MODE=shadow
TRADER_PORTFOLIO_SELECTOR_MAX_BOTS=5
TRADER_PORTFOLIO_SELECTOR_MAX_BOT_WEIGHT=0.01
TRADER_PORTFOLIO_SELECTOR_MAX_GROSS_WEIGHT=0.05
TRADER_PORTFOLIO_SELECTOR_WEIGHT_STEP=0.01
TRADER_PORTFOLIO_SELECTOR_MAX_DRAWDOWN=0.10
TRADER_PORTFOLIO_SELECTOR_MIN_DAYS=10
TRADER_PORTFOLIO_SELECTOR_BOOTSTRAP_SAMPLES=1000
TRADER_PORTFOLIO_SELECTOR_BLOCK_DAYS=7
TRADER_PORTFOLIO_SELECTOR_ROTATION_IMPROVEMENT=0.02
TRADER_PORTFOLIO_SELECTOR_ROTATION_PROBABILITY=0.90
# Reconsider the exact reviewed UUID fleet after 10 complete UTC evidence
# days. The transition remains fail-closed until live net return, drawdown,
# execution reliability, status health, and strict selector admission all pass.
TRADER_PORTFOLIO_AUTO_GRADUATE_ENABLED=true
TRADER_PORTFOLIO_AUTO_GRADUATE_STARTED_AT_MS=1787809701000
TRADER_PORTFOLIO_AUTO_GRADUATE_MIN_DAILY_OBSERVATIONS=10
TRADER_PORTFOLIO_AUTO_GRADUATE_MIN_NET_RETURN=0
TRADER_PORTFOLIO_AUTO_GRADUATE_MAX_DRAWDOWN=0.10
TRADER_PORTFOLIO_AUTO_GRADUATE_MIN_EXECUTION_ATTEMPTS=10
TRADER_PORTFOLIO_AUTO_GRADUATE_MIN_EXECUTION_RELIABILITY=0.95
TRADER_PORTFOLIO_AUTO_GRADUATE_MIN_STATUS_RELIABILITY=0.99
TRADER_PORTFOLIO_AUTO_GRADUATE_MAX_BASELINE_AGE_SEC=900
TRADER_PORTFOLIO_AUTO_GRADUATE_STATUS_INTERVAL_SEC=900
TRADER_PORTFOLIO_AUTO_GRADUATE_MAX_LATEST_STATUS_AGE_SEC=900
TRADER_PORTFOLIO_AUTO_GRADUATE_REVIEW_EVERY_SEC=3600

# Trading consumes the shared leaderboard while the research role owns both
# discovery and evidence backfills, avoiding duplicate CPU-heavy refreshes.
TRADER_TOP_COMBOS_BACKTEST_ENABLED=false
TRADER_TOP_COMBOS_BACKTEST_TOP_N=80
TRADER_TOP_COMBOS_BACKTEST_EVERY_SEC=10800
TRADER_TOP_COMBOS_BACKTEST_STALE_DAYS=2
TRADER_TOP_COMBOS_BACKTEST_PRUNE_FINAL_EQUITY_FLOOR=1.01

# Keep live/read-only replicas from projecting the shared combo bus below the
# research producers' retention.
TRADER_OPTIMIZER_MAX_COMBOS=5000
TRADER_TOP_COMBOS_SYNC_INITIAL_DELAY_SEC=30
# The sync fetches and fully decodes the ~80 MB leaderboard from S3, the DB
# and the local file on every pass; at 60 s that churn drove the API to the
# box's memory limit on 2026-10-12. Trading only consumes the leaderboard and
# pins its UUIDs, so a 15-minute cadence is sufficient.
TRADER_TOP_COMBOS_SYNC_EVERY_SEC=900
TRADER_TOP_COMBOS_SYNC_MAX_COMBOS=5000

# Retain the live fleet records and previous pins for position recovery.
# Retention preserves evidence without bypassing retirement or eligibility.
TRADER_TOP_COMBOS_RETAIN_UUIDS=efe1c81e-2094-c945-af30-8bf25a554157,da78765a-657f-5589-af9c-d289555660cc,62c95834-cbb5-7dba-a5b9-25594e9df953,76a9c22a-45ff-94b9-067f-f3d3c7b8350f,9a50374e-f0ba-f495-bb4b-2bf3c4478921,bc1abfd5-ebce-22cd-ec1f-798e3ce2595f,35a1c1f6-58ad-5bd4-0ae9-5d8513372261,a9974fcf-5e6d-e068-bfac-000e85f79054,ced37172-1552-1b1b-be6d-4816b162654b,a742d6ca-35f6-9d0e-1730-1046b2148de3,05081a5e-18b2-826c-d3b0-1ce92dfecc36,7b7cbf5e-e185-1b7b-9424-1d65a9e22d07,326e5ae0-734a-d55b-157d-e72ba5405790,7a6d8382-1721-e94b-3687-83acd59f72b8,9d121903-9ec9-673d-cc35-b79c033b671b,fdde9030-a258-aec8-3029-40bd5325bf66,a7966572-3bae-f810-8c2a-1d062c189d24,4d506e36-2922-0643-615b-dc2192d68c46,ad4dd449-8052-c94f-5c80-760cbd630b37,f5441231-6161-db5a-e33f-a912ac7a6654,db3ec40a-bd50-1043-3b6a-7d1484526ae9,d1de37ed-f901-d7e7-02c1-06a9b40fc349,e2524ed5-6e09-7c18-bbe6-097a772f4092,13a260fc-b124-beb9-2c32-d2fe8ba08a28,f7dca38c-de7b-294d-a4e0-6c78526128df,3cad5e14-c842-ea26-8c87-1e865ecf357b,984f89ce-991a-96b1-5ef1-acfc13cf85bd,c089b5f4-e289-7da8-5974-bf1070c3a9c7,796f12cb-8aee-1cc4-b9df-43924534aeb5
