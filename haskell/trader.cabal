                     , Trader.TechnicalAnalysis.Strategies
                     , Trader.Text
                     , Trader.Trading
                     , Trader.Types.Safe
                     , Trader.VolConfGate
                     , Paths_trader
  default-language:    Haskell2010
  build-depends:       base >=4.14 && <4.20
                     , aeson >=1.5
                     , bytestring >=0.10
                     , base16-bytestring
                     , cassava >=0.5
                     , case-insensitive
                     , cryptonite
                     , directory
                     , filepath
                     , memory
                     , network
                     , network-uri
                     , http-client
                     , http-client-tls
                     , http-types
                     , websockets
                     , wuss
                     , containers
                     , wai
                     , warp
                     , unordered-containers
                     , optparse-applicative >=0.17
                     , random >=1.2
                     , process
                     , ad >=4.4
                     , scientific
                     , stm
                     , text
                     , time
                     , postgresql-simple >=0.6 && <0.7
                     , uuid
                     , vector >=0.12
  -- Main.hs is large enough that GHC 9.4 optimized builds stall locally/CI;
  -- the production Docker image already builds this executable at -O0.
  ghc-options:         -O0 -threaded -rtsopts -with-rtsopts=-N

