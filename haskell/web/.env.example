# Used by `vite.config.ts` to proxy `/api/*` to the Haskell backend during dev.
TRADER_API_TARGET=http://127.0.0.1:8080

# Optional: if the backend requires auth (TRADER_API_TOKEN is set), the dev proxy can attach it.
# The repo-root `.env` is also loaded and takes precedence for direct `npm run dev`.
# TRADER_API_TOKEN=
