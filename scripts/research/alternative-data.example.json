{
  "schemaVersion": 1,
  "cache": "../../data/research/alternative-observations.csv",
  "sources": [
    {
      "id": "fred-dxy",
      "enabled": false,
      "family": "macro",
      "adapter": "json",
      "location": "https://api.stlouisfed.org/fred/series/observations",
      "query": { "series_id": "DTWEXBGS", "file_type": "json" },
      "queryFromEnv": { "api_key": "TRADER_FRED_API_KEY" },
      "recordsPath": "observations",
      "eventTimeField": "date",
      "publicationLagSeconds": 86400,
      "valueField": "value",
      "metric": "dxy",
      "aggregation": "last",
      "transform": "zscore",
      "maxAgeSeconds": 604800
    },
    {
      "id": "central-bank-policy",
      "enabled": false,
      "family": "policy",
      "adapter": "csv",
      "location": "feeds/policy.csv",
      "eventTimeField": "eventTime",
      "availableTimeField": "availableTime",
      "valueField": "surprise",
      "metric": "policy_surprise",
      "aggregation": "last",
      "transform": "raw",
      "maxAgeSeconds": 604800
    },
    {
      "id": "news-feed",
      "enabled": false,
      "family": "news",
      "adapter": "rss",
      "location": "https://example.com/news.rss",
      "eventTimeField": "pubDate",
      "textField": "description",
      "valueMode": "sentiment",
      "metric": "news_sentiment",
      "aggregation": "mean",
      "transform": "zscore"
    },
    {
      "id": "company-fundamentals",
      "enabled": false,
      "family": "fundamentals",
      "adapter": "csv",
      "location": "feeds/fundamentals.csv",
      "eventTimeField": "periodEnd",
      "availableTimeField": "filedAt",
      "valueField": "surprise",
      "entityField": "ticker",
      "revisionField": "accession",
      "metric": "earnings_surprise",
      "aggregation": "last",
      "transform": "raw",
      "maxAgeSeconds": 7776000
    },
    {
      "id": "onchain-provider",
      "enabled": false,
      "family": "onchain",
      "adapter": "json",
      "location": "https://provider.example/v1/onchain",
      "queryFromEnv": { "api_key": "TRADER_ONCHAIN_API_KEY" },
      "recordsPath": "data",
      "eventTimeField": "timestamp",
      "availableTimeField": "availableAt",
      "valueField": "value",
      "entity": "BTC",
      "metric": "active_addresses",
      "aggregation": "last",
      "transform": "zscore",
      "maxAgeSeconds": 172800
    },
    {
      "id": "stablecoin-supply",
      "enabled": false,
      "family": "stablecoin",
      "adapter": "csv",
      "location": "feeds/stablecoins.csv",
      "eventTimeField": "timestamp",
      "availableTimeField": "availableTime",
      "valueField": "supply",
      "metric": "supply",
      "aggregation": "last",
      "transform": "pct_change",
      "maxAgeSeconds": 172800
    },
    {
      "id": "regulated-fund-flows",
      "enabled": false,
      "family": "institutional_flows",
      "adapter": "csv",
      "location": "feeds/institutional-flows.csv",
      "eventTimeField": "session",
      "availableTimeField": "publishedAt",
      "valueField": "netFlowUsd",
      "entity": "BTC",
      "metric": "net_flow",
      "aggregation": "sum",
      "transform": "zscore"
    },
    {
      "id": "miner-validator-activity",
      "enabled": false,
      "family": "network",
      "adapter": "csv",
      "location": "feeds/network.csv",
      "eventTimeField": "timestamp",
      "availableTimeField": "availableTime",
      "valueField": "value",
      "entityField": "asset",
      "metric": "miner_validator_pressure",
      "aggregation": "last",
      "transform": "zscore",
      "polarity": -1
    },
    {
      "id": "developer-activity",
      "enabled": false,
      "family": "developer",
      "adapter": "json",
      "location": "https://api.github.com/repos/OWNER/REPO/commits",
      "recordsPath": "",
      "eventTimeField": "commit.committer.date",
      "valueMode": "count",
      "metric": "commits",
      "entity": "BTC",
      "aggregation": "count",
      "transform": "zscore"
    },
    {
      "id": "governance-and-unlocks",
      "enabled": false,
      "family": "governance",
      "adapter": "csv",
      "location": "feeds/governance.csv",
      "eventTimeField": "effectiveAt",
      "availableTimeField": "announcedAt",
      "valueField": "supplyImpactPct",
      "entityField": "token",
      "metric": "supply_impact",
      "aggregation": "sum",
      "transform": "zscore",
      "polarity": -1
    },
    {
      "id": "search-and-web-attention",
      "enabled": false,
      "family": "attention",
      "adapter": "csv",
      "location": "feeds/attention.csv",
      "eventTimeField": "periodStart",
      "availableTimeField": "availableTime",
      "valueField": "index",
      "entityField": "asset",
      "metric": "attention_index",
      "aggregation": "last",
      "transform": "zscore",
      "maxAgeSeconds": 1209600
    },
    {
      "id": "social-community",
      "enabled": false,
      "family": "social",
      "adapter": "json",
      "location": "https://provider.example/v1/social",
      "headersFromEnv": { "Authorization": "TRADER_SOCIAL_API_AUTH" },
      "recordsPath": "data",
      "eventTimeField": "periodStart",
      "availableTimeField": "availableAt",
      "valueField": "sentiment",
      "entityField": "asset",
      "metric": "sentiment",
      "aggregation": "last",
      "transform": "zscore",
      "maxAgeSeconds": 21600
    },
    {
      "id": "prediction-market-probability",
      "enabled": false,
      "family": "prediction_market",
      "adapter": "csv",
      "location": "feeds/prediction-markets.csv",
      "eventTimeField": "observedAt",
      "availableTimeField": "observedAt",
      "valueField": "probability",
      "entity": "BTC",
      "metric": "event_probability",
      "aggregation": "last",
      "transform": "delta",
      "maxAgeSeconds": 3600
    },
    {
      "id": "real-world-operations",
      "enabled": false,
      "family": "real_world",
      "adapter": "csv",
      "location": "feeds/real-world.csv",
      "eventTimeField": "measurementTime",
      "availableTimeField": "publishedAt",
      "valueField": "value",
      "metric": "operational_index",
      "aggregation": "last",
      "transform": "zscore",
      "maxAgeSeconds": 604800
    },
    {
      "id": "security-incidents",
      "enabled": false,
      "family": "security",
      "adapter": "rss",
      "location": "https://example.com/security.rss",
      "eventTimeField": "pubDate",
      "textField": "description",
      "valueMode": "sentiment",
      "metric": "incident_score",
      "aggregation": "sum",
      "transform": "zscore",
      "polarity": -1
    },
    {
      "id": "sec-filings",
      "enabled": false,
      "family": "filings",
      "adapter": "csv",
      "location": "feeds/sec-filings.csv",
      "eventTimeField": "periodEnd",
      "availableTimeField": "filedAt",
      "valueMode": "count",
      "entityField": "cik",
      "revisionField": "accession",
      "metric": "filing_count",
      "aggregation": "count",
      "transform": "zscore"
    },
    {
      "id": "cftc-positioning",
      "enabled": false,
      "family": "cot",
      "adapter": "csv",
      "location": "feeds/cot.csv",
      "eventTimeField": "asOfDate",
      "availableTimeField": "publishedAt",
      "valueField": "leveragedFundsNet",
      "entityField": "contract",
      "metric": "leveraged_funds_net",
      "aggregation": "last",
      "transform": "zscore",
      "maxAgeSeconds": 1209600
    },
    {
      "id": "options-volatility",
      "enabled": false,
      "family": "options_vol",
      "adapter": "csv",
      "location": "feeds/options.csv",
      "eventTimeField": "timestamp",
      "availableTimeField": "timestamp",
      "valueField": "dvol",
      "entityField": "asset",
      "metric": "dvol",
      "aggregation": "last",
      "transform": "zscore",
      "maxAgeSeconds": 7200
    },
    {
      "id": "non-exchange-microstructure-archive",
      "enabled": false,
      "family": "microstructure",
      "adapter": "csv",
      "location": "feeds/microstructure.csv",
      "eventTimeField": "timestamp",
      "availableTimeField": "availableTime",
      "valueField": "liquidationUsd",
      "entityField": "asset",
      "metric": "liquidations",
      "aggregation": "sum",
      "transform": "zscore",
      "polarity": -1
    }
  ]
}
